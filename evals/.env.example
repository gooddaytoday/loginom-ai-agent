# Новый контракт: docs/parallel-users-contract.md; live v2 пока не квалифицирован.
# Legacy exclusive использует настройки Loginom ниже; не применять broad cleanup к marker v2.
# V2: один Server/Studio, user/profile/workspace/history на слот; --parallel N (default 1).
# EVAL_SLOTS_FILE=/home/kiselev/.local/state/loginom-evals/parallel/slots.json
# stateDir не переносит /var/lib/loginom-evals/locks; prepare проверяет bootstrap root.
# prepare/verify выпускают чистые reservations; crash требует incident/recover, не rm lease.
# Архив -> server close/readback -> только свои files/backups -> release; unknown сохраняет fence.
# Restart сервера для слота запрещён. Legacy/dev/remote и pins начатых серий сохраняются.
# Нормативная приёмка N=2 -> N=1: gpt-6-luna/high, gpt-6-sol/xhigh; node архив по slot_id.
# interrupted_cleanup относится только к interrupted попыткам; admin state вне mounts/env/results.

# Loginom (локальный docker-стенд)
LOGINOM_URL=http://localhost/app/
LOGINOM_USERNAME=user
LOGINOM_PASSWORD=
LOGINOM_CONTAINER=loginom-server-master
LOGINOM_STORAGE_DIR=/workdir/UserStorage/user

# Dock: ОТДЕЛЬНЫЙ ключ для eval (не ключ Desktop) — память OpenViking привязана к ключу
LOGINOM_DOCK_API_KEY=
LOGINOM_DOCK_BASE_URL=https://loginom.duckdns.org

# Испытуемый агент
EVAL_AGENT_MODEL=openai/gpt-6-luna
EVAL_AGENT_VARIANT=high
EVAL_CLI_MODE=binary
EVAL_CLI_BIN=/home/user/.local/bin/loginom-ai-agent-cli
EVAL_CLI_BUNDLE=.bundle
EVAL_WORKSPACE_ROOT=/tmp/loginom-evals
# Запасной путь: OpenAI-compatible провайдер вместо OAuth
# EVAL_AGENT_PROVIDER_ID=xiaomi-token-plan-sgp
# EVAL_AGENT_PROVIDER_BASE_URL=
# EVAL_AGENT_PROVIDER_API_KEY=
# EVAL_AGENT_PROVIDER_MODEL_ID=mimo-v2.5-pro

# Артефакт
EVAL_ARTIFACT_SOURCE=docker

# Судья
JUDGE_MODEL=gpt-6-sol
JUDGE_REASONING=xhigh
EVAL_JUDGE_COMMAND=codex

# Лимиты
EVAL_REPEAT=1
EVAL_TASK_TIMEOUT_MS=900000
EVAL_JUDGE_TIMEOUT_MS=300000
EVAL_PASS_THRESHOLD=70
EVAL_CALIBRATION_POSITIVE_MIN=90
EVAL_CALIBRATION_NEGATIVE_MAX=40
