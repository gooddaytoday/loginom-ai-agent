      "kind": "column",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "Expression=\"EncodeDate(Year(timestamp), Month(timestamp), Day(timestamp))\"",
          "to": "Expression=\"timestamp\"",
          "count": 1
        }
      ],
      "result_csv": "timestamp-not-day.csv",
      "expected_failed": [
        "calendar-grain",
        "result-full"
      ],
      "expected_oracle_pass": false,
      "reproduce": {
        "python_edits": [
          {
            "from": "        day = datetime.strptime(row[\"timestamp\"], \"%Y-%m-%dT%H:%M:%S\").date().isoformat()",
            "to": "        day = datetime.strptime(row[\"timestamp\"], \"%Y-%m-%dT%H:%M:%S\").isoformat()",
            "count": 1
          },
          {
            "from": "        actual = worked[row[\"employee_id\"], row[\"date\"]]",
            "to": "        actual = worked[row[\"employee_id\"], row[\"date\"] + \"T00:00:00\"]",
            "count": 1
          }
        ]
      }
    },
    {
      "id": "signed-daily-overtime",
      "kind": "column",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "Expression=\"IFF(NVLF(logged_minutes, 0) &gt; planned_minutes, NVLF(logged_minutes, 0) - planned_minutes, 0)\"",
