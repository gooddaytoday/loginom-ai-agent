  "cases": [
    {
      "id": "unsquared-hhi",
      "kind": "aggregate",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "Expression=\"fresh_share * fresh_share + milk_share * milk_share + grocery_share * grocery_share + frozen_share * frozen_share + detergents_share * detergents_share + delicassen_share * delicassen_share\"",
          "to": "Expression=\"fresh_share + milk_share + grocery_share + frozen_share + detergents_share + delicassen_share\"",
          "count": 1
        }
      ],
      "result_csv": "unsquared-hhi.csv",
      "expected_failed": [
        "concentration_metrics",
        "result-full"
      ],
      "expected_oracle_pass": false,
      "reproduce": {
        "python_edits": [
          {
            "from": "hhi = Fraction(sum(value * value for value in values), total * total)",
            "to": "hhi = Fraction(sum(values), total)",
            "count": 1
          }
        ]
      }
    },
    {
      "id": "effective-not-inverse",
      "kind": "column",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "Expression=\"1 / hhi\"",
          "to": "Expression=\"hhi\"",
          "count": 1
        }
      ],
      "result_csv": "effective-not-inverse.csv",
      "expected_failed": [
        "concentration_metrics",
        "result-full"
      ],
      "expected_oracle_pass": false,
      "reproduce": {
        "python_edits": [
          {
            "from": "metrics = [hhi, 1 / hhi, Fraction(max(values), total)]",
            "to": "metrics = [hhi, hhi, Fraction(max(values), total)]",
            "count": 1
          }
        ]
      }
    },
    {
      "id": "money-one-decimal",
      "kind": "column",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "Expression=\"Concat(Str(Int(total_spend)), &quot;.00&quot;)\"",
          "to": "Expression=\"Concat(Str(Int(total_spend)), &quot;.0&quot;)\"",
          "count": 1
        }
      ],
      "result_csv": "money-one-decimal.csv",
      "expected_failed": [
        "result-full"
