  "cases": [
    {
      "id": "latest-payment",
      "kind": "aggregate",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "GroupFunctions=\"gdMin\" Order=\"0\"",
          "to": "GroupFunctions=\"gdMax\" Order=\"0\"",
          "count": 1
        },
        {
          "file": "Unit_0/Unit.xml",
          "from": "<Mapping Source=\"paid_at_Min\"/>",
          "to": "<Mapping Source=\"paid_at_Max\"/>",
          "count": 1
        }
      ],
      "result_csv": "latest-payment.csv",
      "expected_failed": [
        "eligible_first_payment",
        "complete_result"
      ],
      "expected_oracle_pass": false,
      "reproduce": {
        "python_edits": [
          {
            "from": "        first[row[\"invoice_id\"]] = min(first.get(row[\"invoice_id\"], paid), paid)",
            "to": "        first[row[\"invoice_id\"]] = max(first.get(row[\"invoice_id\"], paid), paid)",
            "count": 1
          }
        ]
      }
    },
    {
      "id": "month-without-year",
      "kind": "column",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "Expression=\"12 * (payment_year - issue_year) + payment_month_number - issue_month_number\"",
          "to": "Expression=\"payment_month_number - issue_month_number\"",
          "count": 1
        }
      ],
      "result_csv": "month-without-year.csv",
      "expected_failed": [
        "calendar_classes",
        "complete_result"
      ],
      "expected_oracle_pass": false,
      "reproduce": {
        "python_edits": [
          {
            "from": "                lag = 12 * (paid.year - issued.year) + paid.month - issued.month\n                category = {0: \"same_month\", 1: \"next_month\"}.get(lag, \"later\")",
            "to": "                lag = paid.month - issued.month\n                category = {0: \"same_month\", 1: \"next_month\"}.get(lag, \"later\" if lag > 1 else None)",
            "count": 1
          },
          {
            "from": "        group[category] += 1",
            "to": "        if category is not None:\n            group[category] += 1",
            "count": 1
          }
        ]
      }
    },
    {
      "id": "exclusive-snapshot",
      "kind": "filter",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "Name=\"issued_at\" ConcatenationType=\"ctAnd\" DataType=\"dtString\" RelationType=\"frtLessOrEqual\"",
          "to": "Name=\"issued_at\" ConcatenationType=\"ctAnd\" DataType=\"dtString\" RelationType=\"frtLess\"",
          "count": 1
        },
        {
          "file": "Unit_0/Unit.xml",
          "from": "Name=\"paid_at\" ConcatenationType=\"ctAnd\" DataType=\"dtString\" RelationType=\"frtLessOrEqual\"",
          "to": "Name=\"paid_at\" ConcatenationType=\"ctAnd\" DataType=\"dtString\" RelationType=\"frtLess\"",
          "count": 1
        }
      ],
      "result_csv": "exclusive-snapshot.csv",
      "expected_failed": [
        "invoice_population",
        "eligible_first_payment",
        "complete_result"
      ],
      "expected_oracle_pass": false,
      "reproduce": {
        "python_edits": [
          {
            "from": "or paid > snapshot:",
            "to": "or paid >= snapshot:",
            "count": 1
          },
          {
            "from": "        if issued > snapshot:",
            "to": "        if issued >= snapshot:",
            "count": 1
          }
        ]
