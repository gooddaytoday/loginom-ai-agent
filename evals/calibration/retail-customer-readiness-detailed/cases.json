  "cases": [
    {
      "id": "description-first",
      "kind": "column",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "IF(NVL(CustomerID, &quot;&quot;) = &quot;&quot;, &quot;missing_customer&quot;, IF(NVL(Description, &quot;&quot;) = &quot;&quot;, &quot;missing_description&quot;,",
          "to": "IF(NVL(Description, &quot;&quot;) = &quot;&quot;, &quot;missing_description&quot;, IF(NVL(CustomerID, &quot;&quot;) = &quot;&quot;, &quot;missing_customer&quot;,",
          "count": 1
        }
      ],
      "expected_failed": [
        "exclusive-quality-priority",
        "result-table"
      ],
      "reproduce": {
        "python_edits": [
          {
            "from": "\"missing_customer\" if row[\"CustomerID\"] == \"\" else\n                \"missing_description\" if row[\"Description\"] == \"\" else",
            "to": "\"missing_description\" if row[\"Description\"] == \"\" else\n                \"missing_customer\" if row[\"CustomerID\"] == \"\" else",
            "count": 1
          }
        ]
      },
      "expected_oracle_pass": false,
      "result_csv": "description-first.csv"
    },
    {
      "id": "invoices-as-rows",
      "kind": "aggregate",
      "edits": [
