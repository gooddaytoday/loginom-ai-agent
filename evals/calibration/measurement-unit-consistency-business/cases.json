      "id": "casefold-cm-code",
      "kind": "column",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "&quot;^cm",
          "to": "&quot;^(cm|CM)",
          "count": 1
        }
      ],
      "expected_failed": [
        "exact-unit-coverage",
        "valid-only-length-and-mass",
        "result-table"
      ],
      "reproduce": {
        "python_edits": [
          {
            "from": "\"cm\": Decimal(\"0.01\"),",
            "to": "\"cm\": Decimal(\"0.01\"), \"CM\": Decimal(\"0.01\"),",
            "count": 1
          }
        ]
      },
      "expected_oracle_pass": false,
      "result_csv": "casefold-cm-code.csv"
    },
    {
      "id": "include-unknown-mass",
      "kind": "column",
      "edits": [
        {
          "file": "Unit_0/Unit.xml",
          "from": "Expression=\"IFF(factor_m &gt; 0, mass_kg, 0.0)\"",
          "to": "Expression=\"mass_kg\"",
          "count": 1
        }
      ],
      "expected_failed": [
        "valid-only-length-and-mass",
