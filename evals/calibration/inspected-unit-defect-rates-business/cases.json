            "from": "        severity[row[\"unit_id\"]] = max(severity.get(row[\"unit_id\"], 0), int(row[\"severity\"]))",
            "to": "        severity.setdefault(row[\"unit_id\"], []).append(int(row[\"severity\"]))",
            "count": 1
