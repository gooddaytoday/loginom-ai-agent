  "parameter_schema": {
    "type": "object",
    "properties": {
      "excel_export": {
        "type": "object",
        "description": "New: destination, sheet_name, header, overwrite. Numeric options optional. Existing node: preserve omissions.",
        "properties": {
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Own .xlsx or .xls matching mode in selected exports directory."
          },
          "sheet_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 31,
            "description": "One worksheet; no []:*?/\\ or edge apostrophes."
          },
          "header": {
            "type": "string",
            "enum": [
              "none",
              "names",
              "labels"
            ],
            "description": "No header, names or labels."
          },
          "overwrite": {
            "type": "string",
            "enum": [
              "reject",
              "replace"
            ],
            "description": "reject by default; replace requires explicit whole-file replacement permission. No append or sheet replacement."
          },
          "number_format": {
            "type": "string",
            "enum": [
              "general",
              "numeric"
            ],
            "description": "Native numeric cell display; preserve stored values."
          },
          "decimal_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30,
            "description": "Display decimals when number_format is numeric."
          },
          "divide_thousands": {
            "type": "boolean",
            "description": "Grouping for numeric display."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
