  "parameter_schema": {
    "type": "object",
    "description": "Complete native left enrichment. Up to 14 lookup inputs within the existing 15-input envelope; ports contiguous.",
    "additionalProperties": false,
    "properties": {
      "enrichment": {
        "type": "object",
        "description": "Complete replacement of supported lookup key pairs and global prefix settings; no partial table patch.",
        "additionalProperties": false,
        "required": [
          "tables",
          "prefixes"
        ],
        "properties": {
          "tables": {
            "type": "array",
            "minItems": 1,
            "maxItems": 14,
            "description": "All lookups in ascending contiguous logical port order, independently linked to main input 0.",
            "items": {
              "type": "object",
              "description": "One lookup joined directly to the main input, independently of other lookups.",
              "additionalProperties": false,
              "required": [
                "port",
                "keys"
              ],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 14,
                  "description": "Lookup logical input index 1..14; bind through observed native port identity."
                },
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "description": "Complete nonempty composite key; exact compatible technical field names, each used once per table.",
                  "items": {
                    "type": "object",
                    "description": "One equality between a main field and this lookup's field; no conversion or expression.",
                    "additionalProperties": false,
                    "required": [
                      "main",
                      "lookup"
                    ],
                    "properties": {
                      "main": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "Observed technical field name on main input 0."
                      },
                      "lookup": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "Observed technical field name on this lookup input; excluded from generated output."
                      }
                    }
                  }
                }
              }
            }
          },
          "prefixes": {
            "type": "object",
            "description": "Native global name/label prefixes for lookup fields; final generated names must be read back.",
            "additionalProperties": false,
            "required": [
              "enabled",
              "name",
              "label"
            ],
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable native prefixes for appended lookup fields; main fields stay unchanged."
              },
              "name": {
                "type": "string",
                "maxLength": 128,
                "description": "Literal native technical name prefix; require valid unambiguous resulting identifiers."
              },
              "label": {
                "type": "string",
                "maxLength": 128,
                "description": "Literal native display label prefix; independent of technical name prefix."
              }
            }
          }
        }
      }
    }
  },
