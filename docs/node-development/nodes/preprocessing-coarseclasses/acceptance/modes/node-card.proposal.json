  "parameter_schema": {
    "type": "object",
    "properties": {
      "coarse_classes": {
        "type": "object",
        "properties": {
          "input_field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact observed String/discrete or numeric/continuous predictor name."
          },
          "target_field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact discrete string binary target name, different from input_field; assign output role. Training requires two nonmissing labels."
          },
          "event_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact target label defining the event; must occur in training. WoE uses ln(non-event share/event share)."
          },
          "partition": {
            "type": "string",
            "enum": [
              "automatic",
              "manual",
              "external"
            ],
            "description": "Automatic, manually edited native classes, or native external input 1; no variables."
          },
          "min_class_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 50,
            "description": "Minimum class weight in percent, not a fraction; acceptance uses 5."
          },
          "max_classes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Upper limit on classes, not a promised exact count; acceptance uses 2."
          },
          "uniformity_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "UI uniformity percentage; 0 maximizes IV, 100 favors equal class weights. Acceptance uses 0."
          },
          "continuous": {
            "type": "object",
            "properties": {
              "prequanting": {
                "type": "boolean",
                "description": "Enable native preliminary quantization."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "Preliminary interval count when enabled."
              },
              "include_upper": {
                "type": "boolean",
                "description": "Native include-upper-bound flag."
              }
            },
            "required": [
              "prequanting",
              "include_upper"
            ],
            "additionalProperties": false
          },
          "frozen": {
            "type": "boolean",
            "description": "Freeze materialized partition; execution/apply must not silently recompute boundaries."
          },
          "classes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "description": "Proposal only: native manual class edits, exact categories or numeric bounds.",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 128,
                  "description": "Desired manual class label, subject to native editor confirmation."
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "maxItems": 1000,
                  "description": "Exact discrete category members; NULL differs from empty string."
                },
                "lower": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "format": "local-datetime",
                      "description": "Civil ISO YYYY-MM-DDTHH:mm:ss.sss, without timezone conversion."
                    }
                  ],
                  "description": "Exact numeric lower bound for a continuous class."
                },
                "upper": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "format": "local-datetime",
                      "description": "Civil ISO YYYY-MM-DDTHH:mm:ss.sss, without timezone conversion."
                    }
                  ],
                  "description": "Exact numeric upper bound for a continuous class."
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "input_field",
          "target_field",
          "event_value",
          "partition",
          "min_class_percent",
          "max_classes",
          "uniformity_percent"
        ],
        "additionalProperties": false,
        "description": "Proposal: existing discrete training/apply plus continuous/external/manual/frozen classes. Unknown/NULL categories and zero-frequency behavior require observed native evidence."
      }
    },
    "required": [],
    "additionalProperties": false
  },
