  "parameter_schema": {
    "type": "object",
    "properties": {
      "logistic": {
        "type": "object",
        "properties": {
          "input_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1,
            "maxItems": 128,
            "description": "Complete continuous numeric predictor names; other fields pass through."
          },
          "target_field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "One discrete string target with exactly two non-null classes."
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact event category label, resolved from the observed class list, never an index."
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Explicit cutoff: event if probability >= threshold."
          },
          "selection": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "enum": [
                  "deviance",
                  "aic",
                  "aicc",
                  "bic",
                  "hqic"
                ],
                "description": "Explicit factor selection criterion; significance cutoffs apply only to deviance."
              },
              "entry_significance": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1,
                "description": "Deviance forward/stepwise only: include a factor when its likelihood-ratio p-value is below this cutoff."
              },
              "removal_significance": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1,
                "description": "Deviance backward/stepwise only: remove a factor when its likelihood-ratio p-value exceeds this cutoff; stepwise requires entry < removal."
              }
            },
            "required": [
              "criterion"
            ],
            "additionalProperties": false
          },
          "weight_field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Real positive training frequency weight; native Integer has no Weight role. Exclude it from predictors. Omit for unweighted training."
          },
          "normalization": {
            "type": "string",
            "enum": [
              "none",
              "scale_min_max",
              "scale_minus_one_one",
              "scale_zero_one",
              "absolute_scale",
              "standardize",
              "ratio"
            ],
            "description": "Uniform predictor normalization. Preserve native categorical target encoding; denormalize coefficients to original units."
          },
          "partition": {
            "type": "object",
            "properties": {
              "sampling": {
                "type": "string",
                "enum": [
                  "random",
                  "sequential",
                  "column"
                ]
              },
              "train_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "test_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "column": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "additionalProperties": false,
            "description": "Train/test allocation. Column names an observed partition field; percentages apply only to random/sequential. All predictions still include input rows."
          },
          "validation": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "none",
                  "kfold",
                  "monte_carlo"
                ]
              },
              "folds": {
                "type": "integer",
                "minimum": 2
              },
              "sampling": {
                "type": "string",
                "enum": [
                  "random",
                  "sequential",
                  "column"
                ]
              },
              "column": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "iterations": {
                "type": "integer",
                "minimum": 1
              },
              "train_percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 100
              }
            },
            "additionalProperties": false,
            "description": "Validation within the training allocation. Explicit folds/iterations and seed required when applicable; no guessed PRNG expectations."
          },
          "regularization": {
            "type": "object",
            "properties": {
              "lasso": {
                "type": "number",
                "minimum": 0
              },
              "ridge": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "description": "Manual nonnegative penalties: summed negative log likelihood + lasso*abs(beta) + ridge*beta^2/2; intercept unpenalized. Require the mode-specific penalties."
          }
        },
        "required": [
          "input_fields",
          "target_field",
          "event",
          "threshold"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "logistic"
    ],
    "additionalProperties": false
  },
