{
  "type": "object",
  "properties": {
    "binning": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Exact observed Integer, Real or DateTime input name; only this field is binned."
        },
        "method": {
          "type": "string",
          "enum": [
            "count",
            "width",
            "frequency",
            "sd",
            "manual"
          ],
          "description": "Count/width, frequency by row count, population SD, or explicit materialized intervals."
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "count/frequency: integer bin count; width: positive interval width."
        },
        "limits": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "format": "local-datetime",
                "description": "Civil ISO YYYY-MM-DDTHH:mm:ss.sss, without timezone conversion."
              }
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Optional explicit [lower,upper], lower<upper; omit both for native automatic limits. Values must match selected field type."
        },
        "sd_coefficient": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ],
          "description": "SD bands around mean; 2*k+1 classes including open tails."
        },
        "ties": {
          "type": "string",
          "enum": [
            "next",
            "current"
          ],
          "default": "next",
          "description": "Frequency ties: next (default) moves equal values to the next bin; current keeps them in the current bin. Other tie policies are not admitted."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 1000,
          "description": "Explicit labels in materialized interval order, after training."
        },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "description": "Manual materialized interval edits; adjacent bounds must remain consistent.",
          "items": {
            "type": "object",
            "properties": {
              "lower": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "format": "local-datetime",
                    "description": "Civil ISO YYYY-MM-DDTHH:mm:ss.sss, without timezone conversion."
                  }
                ],
                "description": "Exact typed interval boundary, before open-tail flags."
              },
              "upper": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "format": "local-datetime",
                    "description": "Civil ISO YYYY-MM-DDTHH:mm:ss.sss, without timezone conversion."
                  }
                ],
                "description": "Exact typed interval boundary, before open-tail flags."
              },
              "lower_included": {
                "type": "boolean",
                "description": "Include lower boundary."
              },
              "upper_included": {
                "type": "boolean",
                "description": "Include upper boundary."
              },
              "label": {
                "type": "string",
                "maxLength": 128,
                "description": "Explicit interval label."
              }
            },
            "required": [
              "lower",
              "upper",
              "lower_included",
              "upper_included",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "field",
        "method"
      ],
      "additionalProperties": false,
      "description": "One numeric/DateTime field; train generated bins, then edit materialized intervals/labels without a second Train. Existing apply preserves them. No rounding or open-end options; preserve other fields.",
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "count",
                  "width",
                  "frequency"
                ]
              }
            }
          },
          "then": {
            "required": [
              "size"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "sd"
              }
            }
          },
          "then": {
            "required": [
              "sd_coefficient"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "intervals"
            ]
          }
        }
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
