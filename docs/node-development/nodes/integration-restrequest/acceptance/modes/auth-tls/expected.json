          "label_any": true
        },
        {
          "name": "HttpStatusCode",
          "type": "integer",
          "label_any": true
        }
      ],
      "rows": [
        {
          "AuthMode": "Basic",
          "Authenticated": true,
          "HttpStatusCode": 200
        },
        {
          "AuthMode": "Bearer",
          "Authenticated": true,
          "HttpStatusCode": 200
        }
      ]
    }
  ]
}
