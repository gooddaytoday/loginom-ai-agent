  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "description": "Aggregate the current table into variables output 0. Empty parameters preserve an existing configuration.",
    "properties": {
      "fields": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "description": "Complete selected fields in native field order. Supply the full set when changing configuration.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "input_field"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "kind",
                "name"
              ]
            },
            "aggregations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 14,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "sum",
                  "count",
                  "min",
                  "max",
                  "avg",
                  "median",
                  "mode",
                  "standard_deviation",
                  "unique_count",
                  "null_count",
                  "first",
                  "last",
                  "only",
                  "concat"
                ]
              },
              "description": "Unique functions allowed for the observed native input type; at most 128 output variables in total. Reject disallowed functions before mutation. Field settings are complete replacements; omission preserves an existing node. concat uses native defaults only in this proposed slice."
            }
          },
          "required": [
            "field",
            "aggregations"
          ]
        }
      }
    }
  },
