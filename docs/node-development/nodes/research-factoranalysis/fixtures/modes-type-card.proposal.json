  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "description": "Stage-0 proposal; not a published contract.",
    "properties": {
      "factor_analysis": {
        "type": "object",
        "additionalProperties": false,
        "description": "Proposal: new nodes require features, rotation and factors OR selection. Existing omissions preserve settings; apply preserves the saved model.",
        "properties": {
          "features": {
            "type": "array",
            "description": "Complete continuous numeric feature set in source order.",
            "minItems": 2,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "description": "Exact technical field name.",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "factors": {
            "type": "integer",
            "description": "Requested count. Zero-eigenvalue components have NULL scores and zero loadings.",
            "minimum": 1,
            "maximum": 128
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "description": "Auto selection. Equality on an eigenvalue cutoff is outside the proposed cases.",
            "properties": {
              "criterion": {
                "type": "string",
                "description": "Choose one criterion.",
                "enum": [
                  "eigenvalue",
                  "variance"
                ]
              },
              "threshold": {
                "type": "number",
                "description": "Eigenvalue cutoff 0.1..1.5 or cumulative variance percent 1..100."
              }
            },
            "required": [
              "criterion",
              "threshold"
            ],
            "oneOf": [
              {
                "properties": {
                  "criterion": {
                    "const": "eigenvalue"
                  },
                  "threshold": {
                    "minimum": 0.1,
                    "maximum": 1.5
                  }
                }
              },
              {
                "properties": {
                  "criterion": {
                    "const": "variance"
                  },
                  "threshold": {
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            ]
          },
          "rotation": {
            "type": "string",
            "description": "Explicit orthogonal rotation.",
            "enum": [
              "none",
              "varimax",
              "quartimax"
            ]
          },
          "output_cap": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Integer limits physical factor columns; null disables the cap; omission preserves existing state.",
            "minimum": 1,
            "maximum": 128
          }
        },
        "required": []
      }
    },
    "required": []
  },
