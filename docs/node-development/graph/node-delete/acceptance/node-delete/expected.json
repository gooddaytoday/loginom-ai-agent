          "name": "ID",
          "type": "integer",
          "label_any": true
        },
        {
          "name": "Region",
          "type": "string",
          "label_any": true
        },
        {
          "name": "Amount",
          "type": "real",
          "label_any": true,
          "tolerance": {
            "abs": 1e-09,
            "rel": 0
          }
