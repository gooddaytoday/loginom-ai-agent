    {
      "type": "imports.text"
    },
    {
      "type": "transform.sorting"
    },
    {
      "type": "exports.text"
    }
  ],
  "absent_node_types": [
    "transform.filter_data"
  ],
  "outputs": [
    {
      "output_node_type": "export_input",
      "export_destination": "/sales-sorted.csv",
      "ordered": true,
      "column_order": "exact",
