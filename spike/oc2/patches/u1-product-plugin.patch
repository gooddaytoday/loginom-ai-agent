diff --git a/packages/core/src/plugin/product.ts b/packages/core/src/plugin/product.ts
new file mode 100644
index 0000000000..5a05b77553
--- /dev/null
+++ b/packages/core/src/plugin/product.ts
@@ -0,0 +1,12 @@
+export * as PluginProduct from "./product.js"
+
+// Fork seam (spike U1): product plugins are built in, run last in `post`, and are guarded.
+import { fromPromise } from "@opencode/plugin/promise/adapter"
+import loginom from "./loginom-product/index.ts"
+import type { InternalPlugin } from "./internal.js"
+
+export const plugins: readonly InternalPlugin[] =
+  process.env.LOGINOM_SPIKE_BUILTIN === "1" ? [fromPromise(loginom) as unknown as InternalPlugin] : []
+// LOGINOM_SPIKE_U1_GUARD=0 measures the unguarded baseline: built in and last, but not protected from shadowing.
+export const ids: readonly string[] =
+  process.env.LOGINOM_SPIKE_U1_GUARD === "0" ? [] : plugins.map((plugin) => plugin.id)
