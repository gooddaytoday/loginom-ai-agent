}
`;

exports[`loginom-dashboard: catalog permissions and compatibility against the shipped skill 1`] = `
{
  "en": {
    "can": "Create and edit drafts. Publish or delete a dashboard on your request.",
    "cannot": "Grant access to dashboard tools or publish without your request.",
    "compatibility": "Requires the Loginom dashboard tools.",
  },
  "frontmatter": [
    "name: loginom-dashboard",
    "description: >-",
    "  Создаёт и правит dashboard Loginom в папке dashboard: черновик на localhost по образцу данных узла,",
    "  публикация и удаление по явной просьбе пользователя.",
    "compatibility: Loginom AI Agent Desktop и standalone CLI с инструментами dashboard_draft, dashboard_publish и dashboard_delete.",
  ],
  "ru": {
    "can": "Создать и изменить черновик. Опубликовать или удалить дашборд по вашей просьбе.",
    "cannot": "Дать доступ к инструментам дашборда или опубликовать его без вашей просьбы.",
    "compatibility": "Нужны инструменты для дашбордов Loginom.",
  },
  "rules": [
    "2. Вызови \`dashboard_draft\`. Ошибки сборки, типов и самопроверки исправь сам и вызови снова.",
    "4. Публикуй только после явной просьбы пользователя («Опубликовать»). Вызови \`dashboard_publish\`: пользователь подтвердит узел и пакет. При \`published\` передай сообщение инструмента о том, как увидеть готовую версию в Studio. При \`failed\` объясни причину простыми словами и вернись к черновику: прежняя рабочая версия остаётся доступной.",
    "- Вызывай \`dashboard_delete\` только по явной просьбе удалить дашборд этого узла. Сам запрос в чате открывает подтверждение. Пользователь проверяет имя узла, полный путь пакета и количество опубликованных версий. Согласие одноразовое. Удаление охватывает также локальный черновик и неопубликованные правки.",
  ],
}
`;

