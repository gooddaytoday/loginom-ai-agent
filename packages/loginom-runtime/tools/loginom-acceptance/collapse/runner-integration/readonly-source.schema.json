{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unadmitted independent readonly source receipt interface",
  "description": "Schema validity never grants admission. No real producer is installed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "run_id", "document_id", "path", "sha256", "bytes", "before_any_write", "write_operations", "raw_observation_refs", "download_artifact_sha256", "producer_id"],
  "properties": {
    "kind": {"const": "collapse_readonly_source_v1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-f0-9]{8}$"},
    "document_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "pattern": "^/test-1/"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "before_any_write": {"const": true},
    "write_operations": {"type": "array", "maxItems": 0},
    "raw_observation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "download_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer_id": {"type": "string", "minLength": 1}
  }
}
