{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loginom-dock.duckdns.org/schemas/executor/action-catalog-v1.json",
  "title": "Loginom Dock action catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "e2e_commit",
    "capability_abi",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "e2e_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "capability_abi": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line_start",
        "line_end",
        "commit",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_key",
        "revision",
        "status",
        "capability",
        "input_schema",
        "output_schema",
        "selector_symbols",
        "evidence",
        "preconditions",
        "postconditions",
        "effect",
        "idempotency",
        "timeout_ms",
        "retry_budget",
        "required_capabilities",
        "min_executor_revision",
        "cleanup"
      ],
      "properties": {
        "action_key": {
          "enum": [
            "node.add",
            "link.create",
            "package.save_as",
            "node.configure_text_import",
            "package.save_checkpoint"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "stale"
          ]
        },
        "capability": {
          "enum": [
            "node.add.v1",
            "link.create.v1",
            "package.save_as.v1",
            "node.configure_text_import.v1",
            "package.save_checkpoint.v1"
          ]
        },
        "input_schema": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "selector_symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "preconditions": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "postconditions": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "effect": {
          "type": "object",
          "required": [
            "kind",
            "resource"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "create",
                "save",
                "configure",
                "delete",
                "execute",
                "inspect",
                "transfer",
                "persist"
              ]
            },
            "resource": {
              "type": "string",
              "pattern": "^[a-z]+(?:\\.[a-z_]+)*$"
            },
            "allowed_roots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 2
              }
            },
            "destination_policy": {
              "const": "session_storage"
            }
          }
        },
        "idempotency": {
          "type": "object",
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "const": "reconcile_before_retry"
            }
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000
        },
        "retry_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "required_capabilities": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "min_executor_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "cleanup": {
          "$ref": "#/$defs/nonemptyStrings"
        }
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
